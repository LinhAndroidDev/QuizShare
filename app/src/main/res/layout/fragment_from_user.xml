<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".ui.home.home.user.FragmentFromUser">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp">

        <com.jpardogo.android.googleprogressbar.library.GoogleProgressBar
            android:id="@+id/loadingQuizFromUser"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="70dp"
            android:layout_marginBottom="120dp"
            android:visibility="invisible"
            app:type="chrome_floating_circles" />

        <LinearLayout
            android:id="@+id/linearTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textQuizHomeFromUser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:fontFamily="@font/svn_gilroy_semibold"
                android:text="@string/txtListDepartmentFromUser"
                android:textColor="@color/black"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/seeAllUser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right"
                android:text="@string/txtSeeAll"
                android:textColor="@color/color_purple"
                android:textSize="14sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycleListFromUser"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/linearTitle" />
    </RelativeLayout>

</LinearLayout>