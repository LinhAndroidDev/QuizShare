<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.profile.setting.changeavatar.ChangeAvatarActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="27dp"
            android:layout_marginTop="60dp">

            <ImageView
                android:id="@+id/backChangeAvatar"
                android:layout_width="30dp"
                android:layout_height="25dp"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_back_black" />

            <TextView
                android:id="@+id/txtChangeAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/svn_gilroy_semibold"
                android:text="@string/txtChangeAvatarTitle"
                android:textColor="@color/black"
                android:textSize="24sp" />
        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/txtChangeAvatarHint"
            android:textSize="16sp" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/layoutAvatarEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <!--        <com.jsibbold.zoomage.ZoomageView-->
        <!--            android:id="@+id/avatarEdit"-->
        <!--            android:src="@drawable/logo6"-->
        <!--            android:layout_gravity="center"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="375dp"-->
        <!--            app:zoomage_restrictBounds="false"-->
        <!--            app:zoomage_animateOnReset="true"-->
        <!--            app:zoomage_autoResetMode="UNDER"-->
        <!--            app:zoomage_autoCenter="true"-->
        <!--            app:zoomage_zoomable="true"-->
        <!--            app:zoomage_translatable="true"-->
        <!--            app:zoomage_minScale="0.3"-->
        <!--            app:zoomage_maxScale="8" />-->
        <ImageView
            android:id="@+id/avatarEdit"
            android:layout_width="match_parent"
            android:layout_height="375dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/logo6" />

        <ImageView
            android:id="@+id/strokeAvatar"
            android:layout_width="match_parent"
            android:layout_height="375dp"
            android:background="@drawable/bg_avatar"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="39dp"
        app:cardBackgroundColor="@color/backgroundIntro"
        app:cardCornerRadius="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp"
            android:text="@string/txtDone"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </androidx.cardview.widget.CardView>
</RelativeLayout>